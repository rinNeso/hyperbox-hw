#!/usr/bin/env bash
# hw-watchlist-check -- pacman PreTransaction advisory for hardware-critical packages.
#
# ADVISORY ONLY. This always exits 0. It prints what is about to land that has
# a history with this machine, so you can watch for it; it never stops pacman.
#
# Why no blocking:
#   A PreTransaction hook that exits non-zero aborts the WHOLE transaction --
#   pacman has no way to drop one package from it. On 2026-09-15 a block on
#   limine stopped all 40 queued packages. For must-never-install, use IgnorePkg
#   in /etc/pacman.conf, which is surgical. For must-check-afterwards, use a
#   "verify" entry, which hw-verify runs PostTransaction.
#
# Why no prompt:
#   pacman relays hook stderr line-buffered as [ALPM-SCRIPTLET]. A prompt with
#   no trailing newline sits unflushed in that buffer -- invisible while it
#   blocks on read. That bug ate a 40-package update on 2026-09-15: the terminal
#   looked hung, Enter was taken as the [y/N] default, and the prompt only
#   appeared afterwards, flushed by the newline that followed it. If you ever
#   reintroduce an interactive prompt here, write it to /dev/tty, not stderr.
#
# Escape hatch:  touch /etc/pacman.d/hw-watchlist.off   (silences it entirely)
#                hw-watchlist-check --list              (show the watchlist)

set -uo pipefail

CONF=${HW_WATCHLIST_CONF:-/etc/pacman.d/hw-watchlist.conf}
OFF=${HW_WATCHLIST_OFF:-/etc/pacman.d/hw-watchlist.off}

bold=$'\e[1m'; yel=$'\e[1;33m'; cyn=$'\e[1;36m'; dim=$'\e[2m'; rst=$'\e[0m'

[[ -e $OFF ]] && exit 0
[[ -r $CONF ]] || exit 0

declare -A SEV NOTE
while IFS='|' read -r sev pkg note || [[ -n ${sev:-} ]]; do
    sev=${sev//[[:space:]]/}; pkg=${pkg//[[:space:]]/}
    [[ -z $sev || $sev == \#* || -z $pkg ]] && continue
    SEV[$pkg]=$sev
    NOTE[$pkg]=${note## }
done < "$CONF"

if [[ ${1:-} == --list ]]; then
    printf '%s\n' "${bold}hardware watchlist${rst} ${dim}($CONF)${rst}"
    for p in $(printf '%s\n' "${!SEV[@]}" | sort); do
        c=$yel; [[ ${SEV[$p]} == verify ]] && c=$cyn
        printf '  %b%-6s%b %-24s %s\n' "$c" "${SEV[$p]}" "$rst" "$p" "${NOTE[$p]}"
    done
    exit 0
fi

verifies=(); warns=()
while read -r line; do
    pkg=${line%%[[:space:]]*}
    [[ -z $pkg ]] && continue
    case ${SEV[$pkg]:-} in
        verify) verifies+=("$pkg") ;;
        warn)   warns+=("$pkg") ;;
    esac
done

(( ${#verifies[@]} + ${#warns[@]} )) || exit 0

# Every line ends with a newline so pacman's line-buffered relay flushes it.
{
    echo
    echo "${bold}== hyperBox hardware watchlist ==${rst}"
    for p in ${warns[@]+"${warns[@]}"}; do
        echo "  ${yel}watch ${rst}${bold}$p${rst}"
        echo "         ${NOTE[$p]}"
    done
    for p in ${verifies[@]+"${verifies[@]}"}; do
        echo "  ${cyn}verify${rst} ${bold}$p${rst}"
        echo "         ${NOTE[$p]}"
    done
    echo "  ${dim}advisory only -- checks run after the transaction${rst}"
    echo
} >&2

exit 0
